#!/usr/bin/env python3
import argparse, json, os, pathlib, subprocess, sys, time, uuid

control_base = os.environ.get("MCP_CONTROLLER_CONTROL_DIR")
base = pathlib.Path(control_base) if control_base else pathlib.Path.home()/"Library/Application Support/MCP Controller/Control"
app_path = os.environ.get("MCP_CONTROLLER_APP", "/Applications/MCP Controller.app")
app_executable = pathlib.Path(app_path)/"Contents/MacOS/MCPController"
reqdir, respdir = base/"requests", base/"responses"
default_timeout = float(os.environ.get("MCP_CONTROLLER_TIMEOUT_SECONDS", "30"))

def app_is_running():
    return subprocess.run(["pgrep", "-f", str(app_executable)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

def app_is_ready():
    return app_is_running() and reqdir.exists() and respdir.exists()

def ensure_app():
    subprocess.run(["open", "-g", "-j", "-a", app_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        if app_is_ready():
            return True
        time.sleep(.1)
    return app_is_ready()

def main():
    parser=argparse.ArgumentParser(prog="mcpctl", description="Control MCP Controller from Terminal")
    parser.add_argument("action", help="list, status, show, export, template, new, heading-add, spacer-add, rename, move, save, import, start, stop, restart, start-all, stop-all, logs, clear-logs, route-start, route-stop, remote-url, funnel-start, funnel-stop, funnel-status, use-default-cli, lease, lease-release, lease-release-all, pending, approve, deny, keys, key-add, key-remove, key-show, duplicate, remove, one-ai, check-updates, install-update, open, settings, quit")
    parser.add_argument("target", nargs="?", help="Item name or UUID")
    parser.add_argument("--secrets", action="store_true", help="Include stored secrets in export")
    parser.add_argument("--restart", action="store_true", help="Restart a running server to apply save or key changes")
    parser.add_argument("--file", help="Profile JSON file for save/import")
    parser.add_argument("--enabled", choices=["true","false"], help="Boolean for one-ai")
    parser.add_argument("--name", help="Server or heading name for create/rename; access-key name for key-add")
    parser.add_argument("--description", help="Server description for new")
    parser.add_argument("--executable", help="Absolute executable path for new")
    parser.add_argument("--working-directory", help="Working directory for new")
    parser.add_argument("--local-port", help="Local port for new")
    parser.add_argument("--client-id", help="Waiting client identifier for approve/deny")
    parser.add_argument("--key", help="Access key name or UUID for key-show/key-remove")
    parser.add_argument("--index", help="Destination position for move or insertion position for heading-add/spacer-add")
    parser.add_argument("--timeout", type=float, default=default_timeout, help="Seconds to wait for the controller response")
    args=parser.parse_args()
    if not ensure_app():
        print("MCP Controller is not ready to accept terminal commands.", file=sys.stderr)
        return 2
    reqdir.mkdir(parents=True, exist_ok=True)
    respdir.mkdir(parents=True, exist_ok=True)
    ident=str(uuid.uuid4())
    extra={"secrets":str(args.secrets).lower(), "restart":str(args.restart).lower()}
    if args.file: extra["json"]=pathlib.Path(args.file).read_text()
    if args.enabled: extra["enabled"]=args.enabled
    if args.name: extra["name"]=args.name; extra["keyName"]=args.name
    if args.description: extra["description"]=args.description
    if args.executable: extra["executablePath"]=args.executable
    if args.working_directory: extra["workingDirectory"]=args.working_directory
    if args.local_port: extra["localPort"]=args.local_port
    if args.client_id: extra["clientID"]=args.client_id
    if args.key: extra["key"]=args.key
    if args.index: extra["index"]=args.index
    request={"id":ident,"action":args.action,"target":args.target,"arguments":extra}
    temp=reqdir/(ident+".tmp")
    final=reqdir/(ident+".json")
    temp.write_text(json.dumps(request))
    temp.rename(final)
    response=respdir/(ident+".json")
    deadline=time.time()+max(args.timeout, 1)
    while time.time() < deadline:
        if response.exists():
            result=json.loads(response.read_text())
            response.unlink(missing_ok=True)
            if result.get("payload") is not None: print(result["payload"])
            elif result.get("message"): print(result["message"])
            return 0 if result.get("success") else 1
        time.sleep(.1)
    print(f"MCP Controller did not respond within {args.timeout:g} seconds.", file=sys.stderr)
    return 2
if __name__ == "__main__": raise SystemExit(main())
